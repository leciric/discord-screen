# Copie para .env e preencha. Ou rode "npm run configurar", que faz isso sozinho.

# Assina os tokens. Obrigatório, mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Sem os dois, não abre dentro do Discord.
# No portal: https://discord.com/developers/applications, aba OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Opcional. Confere se a pessoa está mesmo na call, e traz nome, imagem e
# tamanho dos servidores no painel. O bot precisa estar no servidor.
# No mesmo portal, aba Bot, botão Reset Token.
DISCORD_BOT_TOKEN=

# Endereço público. Quem abre o túnel preenche sozinho.
PUBLIC_ORIGIN=http://localhost:31415

# Porta local. Longe da faixa 3000-9000, que costuma estar ocupada por
# outros servidores de desenvolvimento.
PORT=31415

# "production" liga as travas de segurança.
NODE_ENV=development

# Túnel de endereço fixo. Preenchido por "npm run tunel:criar".
TUNEL_CONFIG=

# ID da sua conta, não o Client ID nem o do servidor. Mais de um: separe por vírgula.
# No Discord, não no portal: Configurações, Avançado, Modo desenvolvedor.
# Depois botão direito no seu nome, Copiar ID.
# Só estas contas abrem /admin. Vazio = painel desligado.
DISCORD_ADMIN_ID=

# ID do servidor (guild) do Discord cuja gente pode abrir a página /servidor —
# a que mostra as salas abertas, quem está online e os links de convite.
# Ela sempre pede login do Discord; isto aqui limita a quem está no seu
# servidor. Vazio = qualquer conta do Discord vê. Vários: separe por vírgula.
DISCORD_GUILD_ID=

# A página /servidor. "off" desliga a página e a rota juntas. "aberto" dispensa
# o login (só faça isso se você sabe quem alcança o endereço). Vazio ou
# qualquer outra coisa = exige login do Discord, que é o padrão.
#
# Atenção ao "aberto": a porta desta página é também a porta das salas. O botão
# Entrar vale para as salas nascidas no Discord — a sala de uma call inclusive —,
# então sem login qualquer pessoa com o endereço entra em qualquer sala listada.
# Na sua máquina, à vontade. Num endereço que a internet alcança, não.
PUBLIC_STATUS=

# Opcional. Servidor TURN para a conexão direta entre quem transmite e quem
# assiste. Sem ele o WebRTC ainda funciona na maioria das casas — o STUN
# público basta —, mas quem está atrás de NAT simétrico (CGNAT da operadora,
# rede corporativa) não consegue fechar e cai no relay, que é mais pesado para
# o servidor. TURN encaminha o vídeo de fato, então custa banda.
TURN_URL=
TURN_USER=
TURN_PASS=
